<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Nursery Node: ascolta anche a schermo spento. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Parent Node: avvisi percepibili a telefono silenzioso o a faccia in giù. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Il flash è un di più: l'app deve funzionare anche dove non c'è. -->
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CryLog">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CryLog">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".nursery.NoiseMonitorService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>

</manifest>
