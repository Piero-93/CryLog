<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Nursery Node: ascolta anche a schermo spento. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Ascolto continuo: la CPU deve restare sveglia a schermo spento. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Il video e opt-in: la fotocamera si accende solo se un Parent Node la
         chiede, perche tenerla attiva scalda il telefono e consuma batteria. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Parent Node: avvisi percepibili a telefono silenzioso o a faccia in giù. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Solo per avvisare che dopo un riavvio la sorveglianza e ferma: da
         Android 14 un servizio col microfono non puo partire da qui. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Il flash è un di più: l'app deve funzionare anche dove non c'è. -->
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CryLog">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CryLog">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".parent.CryLogMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service
            android:name=".nursery.NoiseMonitorService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />

        <service
            android:name=".parent.ListenService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".nursery.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
